# Database
DATABASE_URL="file:./dev.db"
# Production:
# DATABASE_URL="postgresql://user:password@localhost:5432/coldpilot"

# Redis (optional, for BullMQ queue)
# REDIS_URL="redis://localhost:6379"

# NextAuth
AUTH_SECRET="your-auth-secret-here"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Google OAuth — create an app at https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID="your-google-client-id-here"
GOOGLE_CLIENT_SECRET="your-google-client-secret-here"

# Microsoft OAuth — create an app at https://portal.azure.com → App registrations
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID="common"

# Cron authorization secret
CRON_SECRET="your-cron-secret-here"
