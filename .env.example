# Database
DATABASE_URL="file:./dev.db"
# Production:
# DATABASE_URL="postgresql://user:password@localhost:5432/coldpilot"

# Redis (optional, for BullMQ queue)
# REDIS_URL="redis://localhost:6379"

# NextAuth
AUTH_SECRET="your-auth-secret-here" # prod: 64+ random chars (openssl rand -hex 32)
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Proxy trust boundary (audit H-1). Only set TRUST_PROXY="true" behind a real
# reverse proxy (Cloudflare). REQUIRE_PROXY="true" collapses any request that
# carries no Cloudflare/vercel forwarding header onto one shared "unknown"
# bucket, so forged X-Forwarded-For can never defeat per-IP rate limits.
# ALLOWED_HOSTS restrict which Host headers the app redirects to / accepts.
# Quoting is optional but harmless (quotes are stripped when parsed).
# TRUST_PROXY="true"
# REQUIRE_PROXY="true"
# ALLOWED_HOSTS="usecoldpilot.com"

# Google OAuth — create an app at https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID="your-google-client-id-here"
GOOGLE_CLIENT_SECRET="your-google-client-secret-here"

# Microsoft OAuth — create an app at https://portal.azure.com → App registrations
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID="common"

# Cron authorization secret
CRON_SECRET="your-cron-secret-here" # prod: 16+ random chars, Bearer token for /api/cron/*

# Encryption key for stored mailbox credentials (AES-256-GCM). REQUIRED —
# boot warns and credential encrypt/decrypt breaks without exactly 64 hex
# chars. Generate: openssl rand -hex 32. BACK THIS UP: losing it makes every
# stored SMTP/IMAP password and OAuth token permanently unreadable.
ENCRYPTION_KEY="your-64-hex-char-encryption-key-here"

# Waitlist mode. When "true", only /, /waitlist and /legal/* stay public and
# everything else redirects to /waitlist (with email capture). Leave unset
# locally. Set on production while the app is pre-launch.
# WAITLIST_MODE="true"
# Secret token that lets YOU bypass the waitlist gate in your own browser:
# visit /api/waitlist/bypass?token=<this value> once, then log in normally.
# WAITLIST_BYPASS_TOKEN="a-long-random-secret"
# Your email to notify on each new waitlist signup (DB-only when unset).
# WAITLIST_NOTIFY_TO="usecoldpilot@gmail.com"

# Billing (Bachs). Leave OFF (unset or anything other than "true") while the
# integration is in sandbox. Set BILLING_ENABLED="true" plus the real
# BACHS_* keys/secrets to activate live checkout + webhooks.
# BILLING_ENABLED="true"
# BACHS_API_KEY="sk_sandbox_..."
# BACHS_WEBHOOK_SECRET="..."
